# syntax=docker/dockerfile:1
FROM maven:3.9.16-amazoncorretto-17-alpine

# Upgrade only the vulnerable package; avoids non-deterministic full apk upgrade
# zlib < 1.3.2-r1 is vulnerable to CVE-2026-85091
RUN apk add --no-cache 'zlib>=1.3.2-r1'

WORKDIR /repo

COPY pom.xml .
RUN --mount=type=secret,id=mvn_settings,target=/root/.m2/settings.xml \
    mvn --batch-mode -f pom.xml dependency:go-offline

ENTRYPOINT ["mvn"]
CMD ["--batch-mode", "test"]
